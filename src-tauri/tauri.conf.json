{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Golden Ledger",
  "version": "0.1.0",
  "identifier": "in.goldenledger.pawn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Golden Ledger — Pawn Management",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:gold-pawn-pro.db"]
    }
  }
}
